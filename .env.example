# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres (shared by db and the Gitea server)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=gitea

# Instance + identity (used by seed.sh)
GITEA_URL=http://localhost:3000
ADMIN_USER=admin
# Admin password: only used when seed.sh creates the admin user on a fresh
# instance; leave empty to let seed.sh generate one (it writes it back here).
# The agent users (pi/opencode/infra/review) + chat get random passwords
# that are deliberately NOT stored — they are operated via API tokens only.
ADMIN_PASSWORD=

# One-time runner registration tokens — minted by seed.sh via the admin API
# (no need to fill these in manually). my-runner = plain CI (ubuntu-latest),
# android-runner = label `android` with the gitea-android job image.
# Agent tasks don't use runners — they go through 00-tea webhooks.
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_RUNNER_ANDROID_REGISTRATION_TOKEN=

# Seed list of repos managed by 00-tea (comma-separated). Optional — repos
# SELF-ENROLL when someone mentions @pi/@opencode/@infra in them (00-tea
# persists them in its sqlite db and grants the agent users write access
# itself). Entries here are pinned (kept across restarts, not removable
# from the /repos UI).
# After editing: docker compose up -d 00-tea && ./seed.sh (agent access)
AGENTD_REPOS=

# Shared secret for Gitea → 00-tea webhooks (HMAC-SHA256). Generated by
# seed.sh; used by both the Gitea hook config and the 00-tea container.
WEBHOOK_SECRET=

# Long-lived API token of the repo owner. Used by the runner process
# itself for Gitea API access; also injected into job containers.
GITEA_TOKEN=

# Agent identities (Gitea usernames — configurable via setup.sh).
# Each work agent is its OWN user (native @mention autocomplete + per-agent
# commit/PR attribution). Names default to the lore names; type a technical
# name (pi, opencode, …) if you prefer. Minted by seed.sh.
AGENT_WORK1_NAME=margherita
AGENT_WORK2_NAME=capricciosa
AGENT_INFRA_NAME=crust
AGENT_REVIEW_NAME=cheese
AGENT_CHAT_NAME=sauce
# Dormant old usernames (comma-separated) — kept for history attribution,
# never act again. Populated automatically when you rename an agent.
AGENT_DORMANT_LOGINS=

# Agent tokens (role-based, minted by seed.sh; leave empty to let it generate)
AGENT_WORK1_TOKEN=
AGENT_WORK2_TOKEN=
AGENT_INFRA_TOKEN=
# READ-only — the reviewer clones with it, so a review task cannot push.
AGENT_REVIEW_TOKEN=
# WRITE — held by 2pizzas ONLY (never given to the reviewer container).
AGENT_REVIEW_POST_TOKEN=
AGENT_CHAT_TOKEN=

# ── @infra agent (repairs the stack itself) ────────────────────────────────
# Repo where infra tasks run + where @infra is accepted (managed repo).
INFRA_REPO=owner/gitea-with-agents
# HOST path of that repo — 00-tea bind-mounts it read-only into the infra
# job container (which also gets the host docker socket; runc, not runsc).
# Leave empty to disable the auto-enqueued infra agent.
INFRA_HOST_REPO=/home/USER/gitea
# One infra task per window: later failures in the window append to the
# existing incident issue instead of storming one agent per task.
INFRA_COOLDOWN_MINUTES=15

# Full-scope API token for repo management (create repos, set template flags).
# A plain user token without write:user cannot create repos via the API.
# Used by seed.sh / sync-template.sh, and by 00-tea for the /android page
# (admin actions-runs API).
ADMIN_TOKEN=

# Inference backends live in inference.json (repo root, gitignored — it
# carries API keys; see inference.json.example): every backend is an
# OpenAI-compatible /v1 endpoint, walked by priority with failover. 00-tea
# reads it at runtime; setup.sh bakes the same list into the agent images.
# The var below is the LEGACY single-backend fallback when inference.json
# is absent (and the default suggested in the wizard).
LLAMA_CPP_URL=http://localhost:8080
# Cores reserved for llama.cpp (run the router with -t $LLAMA_CPUS). setup.sh
# suggests host-cores minus ~4 (kept for the agent jobs — 1 concurrent — chat
# containers and system). Informational: the router is a host service.
LLAMA_CPUS=

# Optional gate for 00-tea's /chat pages + API (the dashboard is reachable on
# the tailnet; a chat spawns a live sandboxed agent). Empty = open, like the
# rest of the UI. If set, /chat and /api/chat* require ?token=… (or the
# x-chat-token header).
CHAT_TOKEN=
# Whole-UI gate (all 00-tea pages + APIs; CHAT_TOKEN is accepted as the value
# and as a fallback when UI_TOKEN is unset)
UI_TOKEN=

# Host interface IPs for port binding (compose binds service ports to these
# only — never 0.0.0.0). tailnet IP is stable per machine; LAN IP may change
# with DHCP — update here (and `docker compose up -d`) when it does.
HOST_TAILNET=
HOST_LAN=

# (chat token is AGENT_CHAT_TOKEN above)

# Resource caps for the long-lived chat containers (user-spawned, live for
# hours). Inference runs on the host's llama.cpp — the container only needs
# room for node + git clones + light builds.
CHAT_MEMORY=4g
CHAT_CPUS=2

# Cap (cores) for one-shot agent job containers — the task pump runs 1 job
# at a time, so this mostly protects the cores reserved for llama.cpp.
AGENT_CPUS=2

# Per-repo clone URLs for the pages/ service instances (one per PAGES_*
# service in docker-compose.yml) + the 00-tea /pages sidebar
# (repo:port:container, comma-separated).
PAGES_REPO=http://gitea:3000/owner/my-repo.git
PAGES_BENCH_REPO=http://gitea:3000/owner/other-repo.git
# PAGES_SITES=owner/my-repo:3002:gitea-pages,owner/other:3004:other-pages
