# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres (shared by db and the Gitea server)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=gitea

# Instance + identity (used by seed.sh)
GITEA_URL=http://localhost:3000
ADMIN_USER=owner
# Passwords: only used when seed.sh creates the users on a fresh instance;
# leave empty to let seed.sh generate one (it writes it back here).
ADMIN_PASSWORD=
BOT_PASSWORD=

# One-time runner registration token — minted by seed.sh via the admin API
# (no need to fill these in manually). Only my-runner uses runners;
# agent tasks go through agentd webhooks.
GITEA_RUNNER_REGISTRATION_TOKEN=

# Shared secret for Gitea → agentd webhooks (HMAC-SHA256). Generated by
# seed.sh; used by both the Gitea hook config and the agentd container.
WEBHOOK_SECRET=

# Long-lived API token of the repo owner (owner). Used by the runner process
# itself for Gitea API access; also injected into job containers.
GITEA_TOKEN=

# API token of the 'bot' user. Agents act as bot so their commits/PRs/comments
# can be reviewed. Create the user + token — see README "Create the bot user".
AGENT_TOKEN=

# Full-scope API token for repo management (create repos, set template flags).
# A plain user token without write:user cannot create repos via the API.
# Also injected into agentd (read-only use: the repos page shows webhook status).
ADMIN_TOKEN=
