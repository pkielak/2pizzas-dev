{
  "_comment": "TEMPLATE — setup.sh generates the real models.json from inference.json (live model list + real key) before building the image. This exists only as the manual fallback the Dockerfile guard points at.",
  "providers": {
    "llama.cpp": {
      "baseUrl": "http://localhost:8080/v1",
      "api": "openai-completions",
      "apiKey": "<your-llama-cpp-api-key>",
      "models": [
        { "id": "<your-model>", "contextWindow": 65536 }
      ]
    }
  }
}
