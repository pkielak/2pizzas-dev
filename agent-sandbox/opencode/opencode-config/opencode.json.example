{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "TEMPLATE — setup.sh generates the real opencode.json from inference.json (live model list + real key) before building the image. This exists only as the manual fallback the Dockerfile guard points at.",
  "model": "llama.cpp/<your-model>",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://<LLAMA_CPP_HOST:PORT>/v1",
        "apiKey": "YOUR_API_KEY"
      },
      "models": {
        "<your-model>": { "name": "<your-model>" }
      }
    }
  }
}
